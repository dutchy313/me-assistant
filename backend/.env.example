PORT=4000
NODE_ENV=development

APP_NAME=M&E Assistant API
APP_BASE_URL_WEB=http://localhost:5173

MONGODB_URI=mongodb+srv://username:password@cluster-name.mongodb.net/me_assistant?retryWrites=true&w=majority

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

LOGIN_TEMP_JWT_SECRET=replace_with_a_different_long_random_secret
LOGIN_TEMP_JWT_EXPIRES_IN=10m

EMAIL_OTP_ENABLED=false
EMAIL_OTP_EXPIRES_MINUTES=10

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_app_password
SMTP_FROM="M&E Assistant <your_email@example.com>"