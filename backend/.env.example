# ================================
# M&E Assistant API Environment
# ================================

# ----------------
# App
# ----------------
PORT=4000
NODE_ENV=development
APP_NAME=M&E Assistant API

# Local web app URL during development:
APP_BASE_URL_WEB=http://localhost:5173

# Production API URL, for documentation and callbacks:
APP_BASE_URL_API=http://localhost:4000

# ----------------
# MongoDB Atlas
# ----------------
# Never commit your real MongoDB password.
# Example:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
MONGODB_URI=

# ----------------
# JWT Authentication
# ----------------
# Use long random values in production.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Temporary token used during optional OTP login flow.
LOGIN_TEMP_JWT_SECRET=
LOGIN_TEMP_JWT_EXPIRES_IN=10m

# ----------------
# Optional Email OTP
# ----------------
# false = normal email/password login
# true  = login requires email OTP verification
EMAIL_OTP_ENABLED=false
EMAIL_OTP_EXPIRES_MINUTES=10

# SMTP example for Gmail App Passwords during local testing.
# For production, use a transactional provider such as Resend, Mailgun, SendGrid, or Amazon SES.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="M&E Assistant <you@example.com>"

# ----------------
# Cloudflare Turnstile Anti-Bot Protection
# ----------------
# true  = registration requires Turnstile verification
# false = Turnstile verification is skipped
#
# Local test secret key:
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#
# Production:
# Use the real secret key from Cloudflare Turnstile.
TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=

# ----------------
# Google Drive Source Library
# ----------------
# Google Drive folder containing your PDF/books.
GOOGLE_DRIVE_FOLDER_ID=

# Service account credentials.
# Keep GOOGLE_PRIVATE_KEY wrapped in quotes and use \n for line breaks.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ----------------
# Google Cloud Document AI OCR
# ----------------
# Required for scanned PDF OCR.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=

# Optional future batch OCR through Google Cloud Storage.
# Not required for current controlled beta unless large-document batch OCR is implemented.
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_CLOUD_STORAGE_INPUT_PREFIX=document-ai/input
GOOGLE_CLOUD_STORAGE_OUTPUT_PREFIX=document-ai/output

# ----------------
# OpenAI
# ----------------
OPENAI_API_KEY=

# Do not change these after vectors have been created unless you recreate and re-embed the Qdrant collection.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Chat and evaluation models.
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EVALUATION_MODEL=gpt-4.1-mini

# ----------------
# Qdrant Vector Database
# ----------------
QDRANT_URL=
QDRANT_API_KEY=

# Do not change this after vectors have been created unless you recreate and re-embed.
QDRANT_COLLECTION_NAME=me_assistant_chunks

# ----------------
# RAG Retrieval Settings
# ----------------
RAG_TOP_K=5
RAG_MIN_SCORE=0.2
RAG_CANDIDATE_K=20
RAG_MAX_CHUNKS_PER_DOCUMENT=2

# ----------------
# Rate Limits
# ----------------
CHAT_RATE_LIMIT_WINDOW_MINUTES=10
CHAT_RATE_LIMIT_MAX_REQUESTS=30

EVALUATION_RATE_LIMIT_WINDOW_MINUTES=10
EVALUATION_RATE_LIMIT_MAX_REQUESTS=20

# ----------------
# Daily Usage Limits
# ----------------
DAILY_CHAT_LIMIT_PER_USER=100
DAILY_EVALUATION_LIMIT_PER_ADMIN=50

# ----------------
# Request Size / Validation
# ----------------
MAX_CHAT_MESSAGE_LENGTH=4000