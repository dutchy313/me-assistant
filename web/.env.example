# ================================
# M&E Assistant Web Environment
# ================================

# Local API URL during development
VITE_API_BASE_URL=http://localhost:4000/api/v1

# ----------------
# Cloudflare Turnstile Anti-Bot Protection
# ----------------
# true  = show Turnstile on registration
# false = hide Turnstile on registration
#
# Local test site key:
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#
# Production:
# Use the real site key from Cloudflare Turnstile.
VITE_TURNSTILE_ENABLED=true
VITE_TURNSTILE_SITE_KEY=